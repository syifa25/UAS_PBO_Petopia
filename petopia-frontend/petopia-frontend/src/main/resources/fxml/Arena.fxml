<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.geometry.*?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.petopia.controller.ArenaController"
      styleClass="root-bg"
      prefWidth="1000" prefHeight="700"
      alignment="TOP_CENTER" spacing="0">

    <!-- NAVBAR -->
    <HBox styleClass="navbar" alignment="CENTER" spacing="80" prefHeight="52">
        <Button fx:id="navHome" text="HOME" styleClass="nav-btn"/>
        <Button fx:id="navMyPets" text="MY PETS" styleClass="nav-btn"/>
        <Button fx:id="navMarketplace" text="MARKETPLACE" styleClass="nav-btn"/>
    </HBox>

    <!-- BATTLE CONTAINER -->
    <VBox spacing="0" alignment="CENTER" VBox.vgrow="ALWAYS" styleClass="battle-container">

        <!-- BATTLE ARENA BOX (main visual) -->
        <VBox styleClass="battle-arena-box" spacing="0">
            <!-- Sky area with pets -->
            <AnchorPane styleClass="battle-sky" prefHeight="220">
                <!-- VS text in center -->
                <Label text="VS" styleClass="battle-vs-text"
                       AnchorPane.topAnchor="60" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0"/>

                <!-- Player side -->
                <VBox spacing="6" AnchorPane.topAnchor="20" AnchorPane.leftAnchor="40">
                    <ImageView fx:id="playerImage" fitWidth="100" fitHeight="100" preserveRatio="true"/>
                    <Label fx:id="playerName" text="PLAYER" styleClass="battle-pet-name"/>
                </VBox>

                <!-- Enemy side -->
                <VBox spacing="6" AnchorPane.topAnchor="20" AnchorPane.rightAnchor="40">
                    <ImageView fx:id="enemyImage" fitWidth="100" fitHeight="100" preserveRatio="true"/>
                    <Label fx:id="enemyName" text="ENEMY" styleClass="battle-pet-name"/>
                </VBox>
            </AnchorPane>

            <!-- Ground area with HP bars -->
            <AnchorPane styleClass="battle-ground" prefHeight="100">
                <!-- Player HP (left) -->
                <VBox spacing="4" AnchorPane.topAnchor="16" AnchorPane.leftAnchor="40">
                    <Label text="HP" styleClass="battle-hp-label"/>
                    <HBox spacing="8" alignment="CENTER_LEFT">
                        <ProgressBar fx:id="playerHpBar" prefWidth="180" styleClass="battle-hp-bar"/>
                        <Label fx:id="playerHpLabel" text="120/120" styleClass="battle-hp-text"/>
                    </HBox>
                </VBox>

                <!-- Enemy HP (right) -->
                <VBox spacing="4" AnchorPane.topAnchor="16" AnchorPane.rightAnchor="40">
                    <Label text="HP" styleClass="battle-hp-label"/>
                    <HBox spacing="8" alignment="CENTER_RIGHT">
                        <Label fx:id="enemyHpLabel" text="110/110" styleClass="battle-hp-text"/>
                        <ProgressBar fx:id="enemyHpBar" prefWidth="180" styleClass="battle-hp-bar"/>
                    </HBox>
                </VBox>
            </AnchorPane>
        </VBox>

        <!-- LOG AREA -->
        <TextArea fx:id="battleLog" editable="false" wrapText="true"
                  prefHeight="140" prefWidth="900" styleClass="battle-log"/>

        <!-- ACTION BUTTONS -->
        <HBox alignment="CENTER" spacing="18" prefHeight="80" styleClass="battle-actions">
            <Button fx:id="attackBtn" styleClass="battle-action-btn attack-btn" prefWidth="180" prefHeight="55">
                <graphic>
                    <VBox alignment="CENTER" spacing="4">
                        <Label text="⚔" styleClass="battle-btn-icon"/>
                        <Label text="ATTACK" styleClass="battle-btn-label"/>
                    </VBox>
                </graphic>
            </Button>
            <Button fx:id="potionBtn" styleClass="battle-action-btn potion-btn" prefWidth="180" prefHeight="55">
                <graphic>
                    <VBox alignment="CENTER" spacing="4">
                        <Label text="🧪" styleClass="battle-btn-icon"/>
                        <Label text="POTION" styleClass="battle-btn-label"/>
                    </VBox>
                </graphic>
            </Button>
            <Button fx:id="fleeBtn" styleClass="battle-action-btn flee-btn" prefWidth="180" prefHeight="55">
                <graphic>
                    <VBox alignment="CENTER" spacing="4">
                        <Label text="💨" styleClass="battle-btn-icon"/>
                        <Label text="FLEE" styleClass="battle-btn-label"/>
                    </VBox>
                </graphic>
            </Button>
        </HBox>

        <!-- BACK HOME BUTTON -->
        <Button fx:id="backHomeBtn" styleClass="back-home-btn" prefWidth="240" prefHeight="40" onAction="#goToHome">
            <graphic>
                <HBox alignment="CENTER" spacing="10">
                    <Label text="←" styleClass="back-icon"/>
                    <Label text="BACK TO HOME" styleClass="back-label"/>
                </HBox>
            </graphic>
        </Button>

    </VBox>
</VBox>