<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.geometry.*?>

<!-- Root StackPane so the result overlay can sit on top of the battle UI -->
<StackPane xmlns="http://javafx.com/javafx"
           xmlns:fx="http://javafx.com/fxml"
           fx:controller="com.petopia.controller.ArenaController"
           prefWidth="1000" prefHeight="700">

    <!-- ═══════════════════════════════════════════
         MAIN BATTLE UI
         ═══════════════════════════════════════════ -->
    <VBox styleClass="root-bg" prefWidth="1000" prefHeight="700" alignment="TOP_CENTER" spacing="0">

        <!-- NAVBAR -->
        <HBox styleClass="navbar" alignment="CENTER" spacing="80" prefHeight="48">
            <Button fx:id="navHome"        text="HOME"        styleClass="nav-btn"/>
            <Button fx:id="navMyPets"      text="MY PETS"     styleClass="nav-btn"/>
            <Button fx:id="navMarketplace" text="LEADERBOARD" styleClass="nav-btn"/>
            <Button fx:id="navLogin"       text="LOGIN"       styleClass="nav-btn"/>
        </HBox>

        <!-- BATTLE CONTAINER -->
        <VBox spacing="8" alignment="CENTER" VBox.vgrow="ALWAYS" styleClass="battle-container">

            <!-- ARENA BOX -->
            <VBox styleClass="battle-arena-box" spacing="0">

                <!-- SKY with pets -->
                <AnchorPane styleClass="battle-sky" prefHeight="220">

                    <!-- VS centered -->
                    <Label text="VS" styleClass="battle-vs-text"
                           AnchorPane.topAnchor="80"
                           AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0"
                           maxWidth="Infinity" alignment="CENTER"/>

                    <!-- Player side -->
                    <VBox spacing="2" alignment="BOTTOM_LEFT"
                          AnchorPane.topAnchor="16" AnchorPane.leftAnchor="60">
                        <ImageView fx:id="playerImage"
                                   fitWidth="96" fitHeight="96" preserveRatio="true"/>
                        <Label fx:id="playerName"  text="PLAYER" styleClass="battle-pet-name"/>
                        <Label fx:id="playerLevel" text="LV.?"   styleClass="battle-pet-level"/>
                    </VBox>

                    <!-- Enemy side -->
                    <VBox spacing="2" alignment="BOTTOM_RIGHT"
                          AnchorPane.topAnchor="16" AnchorPane.rightAnchor="60">
                        <ImageView fx:id="enemyImage"
                                   fitWidth="96" fitHeight="96" preserveRatio="true"/>
                        <Label fx:id="enemyName"  text="ENEMY" styleClass="battle-pet-name"/>
                        <Label fx:id="enemyLevel" text="LV.?"  styleClass="battle-pet-level"/>
                    </VBox>

                </AnchorPane>

                <!-- GROUND with HP bars -->
                <AnchorPane styleClass="battle-ground" prefHeight="90">

                    <!-- Player HP (left) -->
                    <VBox spacing="3" AnchorPane.topAnchor="14" AnchorPane.leftAnchor="50">
                        <Label text="HP" styleClass="battle-hp-label"/>
                        <HBox spacing="8" alignment="CENTER_LEFT">
                            <ProgressBar fx:id="playerHpBar" prefWidth="200" styleClass="battle-hp-bar"/>
                            <Label fx:id="playerHpLabel" text="—/—" styleClass="battle-hp-text"/>
                        </HBox>
                    </VBox>

                    <!-- Enemy HP (right) -->
                    <VBox spacing="3" AnchorPane.topAnchor="14" AnchorPane.rightAnchor="50">
                        <Label text="HP" styleClass="battle-hp-label"
                               maxWidth="Infinity" alignment="CENTER_RIGHT"/>
                        <HBox spacing="8" alignment="CENTER_LEFT">
                            <Label fx:id="enemyHpLabel" text="—/—" styleClass="battle-hp-text"/>
                            <ProgressBar fx:id="enemyHpBar" prefWidth="200" styleClass="battle-hp-bar"/>
                        </HBox>
                    </VBox>

                </AnchorPane>
            </VBox>

            <!-- DIALOGUE LOG — single line, Pokémon style -->
            <Label fx:id="battleLog" text="" styleClass="battle-log"
                   prefWidth="920" prefHeight="60"
                   wrapText="true" alignment="CENTER_LEFT"/>

            <!-- ACTION BUTTONS -->
            <HBox fx:id="actionBox" alignment="CENTER" spacing="16"
                  prefHeight="72" styleClass="battle-actions">
                <Button fx:id="attackBtn" styleClass="battle-action-btn attack-btn"
                        prefWidth="200" prefHeight="56">
                    <graphic>
                        <VBox alignment="CENTER" spacing="3">
                            <Label text="ATTACK" styleClass="battle-btn-label"/>
                        </VBox>
                    </graphic>
                </Button>
                <Button fx:id="potionBtn" styleClass="battle-action-btn potion-btn"
                        prefWidth="200" prefHeight="56">
                    <graphic>
                        <VBox alignment="CENTER" spacing="3">
                            <Label fx:id="potionLabel" text="POTION (1)" styleClass="battle-btn-label"/>
                        </VBox>
                    </graphic>
                </Button>
                <Button fx:id="fleeBtn" styleClass="battle-action-btn flee-btn"
                        prefWidth="200" prefHeight="56">
                    <graphic>
                        <VBox alignment="CENTER" spacing="3">
                            <Label text="FLEE" styleClass="battle-btn-label"/>
                        </VBox>
                    </graphic>
                </Button>
            </HBox>

            <!-- BACK HOME -->
            <Button fx:id="backHomeBtn" styleClass="back-home-btn"
                    prefWidth="260" prefHeight="40" onAction="#goToHome">
                <graphic>
                    <HBox alignment="CENTER" spacing="8">
                        <Label text="←" styleClass="back-icon"/>
                        <Label text="BACK TO HOME" styleClass="back-label"/>
                    </HBox>
                </graphic>
            </Button>

        </VBox>
    </VBox>

    <!-- ═══════════════════════════════════════════
         RESULT OVERLAY — hidden until battle ends
         ═══════════════════════════════════════════ -->
    <StackPane fx:id="resultOverlay" visible="false"
               style="-fx-background-color: rgba(0,0,0,0.72);">

        <VBox fx:id="resultPanel" styleClass="result-panel"
              alignment="CENTER" spacing="20"
              prefWidth="420" maxWidth="420">

            <!-- Icon -->
            <Label fx:id="resultIcon"  text="***" styleClass="result-icon"/>
            <!-- Title: VICTORY / DEFEAT / FLED -->
            <Label fx:id="resultTitle" text="VICTORY" styleClass="result-title"/>
            <!-- Sub message -->
            <Label fx:id="resultMsg"   text="" styleClass="result-msg" wrapText="true"
                   maxWidth="360" alignment="CENTER"/>

            <!-- Buttons -->
            <HBox alignment="CENTER" spacing="16">
                <Button fx:id="playAgainBtn" text="PLAY AGAIN"
                        styleClass="battle-action-btn attack-btn"
                        prefWidth="160" prefHeight="48"
                        onAction="#playAgain"/>
                <Button fx:id="resultHomeBtn" text="HOME"
                        styleClass="battle-action-btn flee-btn"
                        prefWidth="160" prefHeight="48"
                        onAction="#goToHome"/>
            </HBox>

        </VBox>
    </StackPane>

</StackPane>
