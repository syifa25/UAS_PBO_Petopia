<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.geometry.*?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.petopia.controller.HomeController"
      styleClass="root-bg"
      prefWidth="1000" prefHeight="700">

    <!-- NAVBAR -->
    <HBox styleClass="navbar" alignment="CENTER" spacing="80" prefHeight="48">
        <Button fx:id="navHome"        text="HOME"        styleClass="nav-btn nav-active"/>
        <Button fx:id="navMyPets"      text="MY PETS"     styleClass="nav-btn"/>
        <Button fx:id="navMarketplace" text="LEADERBOARD" styleClass="nav-btn"/>
        <Button fx:id="navLogin"       text="LOGIN"       styleClass="nav-btn"/>
    </HBox>

    <VBox alignment="CENTER" spacing="12" VBox.vgrow="ALWAYS" styleClass="main-content">

        <!-- ARENA BOX -->
        <VBox styleClass="arena-box" prefWidth="960" prefHeight="420" maxWidth="960">

            <!-- SKY — stacked horizontal colour bands (no CSS gradient) -->
            <AnchorPane VBox.vgrow="ALWAYS">

                <!-- Band 1: lightest top -->
                <Pane styleClass="arena-sky-band-top"
                      AnchorPane.topAnchor="0" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0"
                      prefHeight="70"/>

                <!-- Band 2: mid blue -->
                <Pane styleClass="arena-sky-band-mid"
                      AnchorPane.topAnchor="70" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0"
                      prefHeight="100"/>

                <!-- Band 3: deeper blue near ground -->
                <Pane styleClass="arena-sky-band-bottom"
                      AnchorPane.topAnchor="170" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0"
                      AnchorPane.bottomAnchor="0"/>

                <!-- TITLE -->
                <Label text="PETOPIA" styleClass="arena-title"
                       AnchorPane.topAnchor="14"
                       AnchorPane.leftAnchor="0"
                       AnchorPane.rightAnchor="0"
                       maxWidth="Infinity" alignment="CENTER"/>

                <!-- LEFT cloud -->
                <Pane styleClass="cloud" prefWidth="100" prefHeight="32"
                      AnchorPane.topAnchor="54" AnchorPane.leftAnchor="70"/>

                <!-- RIGHT cloud -->
                <Pane styleClass="cloud" prefWidth="120" prefHeight="28"
                      AnchorPane.topAnchor="48" AnchorPane.rightAnchor="80"/>

                <!-- PLAYER PET sprite -->
                <ImageView fx:id="playerPetImage"
                           fitWidth="90" fitHeight="90" preserveRatio="true"
                           AnchorPane.bottomAnchor="8"
                           AnchorPane.leftAnchor="100"/>

                <!-- ENEMY PET + platform -->
                <VBox alignment="BOTTOM_CENTER" spacing="0"
                      AnchorPane.bottomAnchor="0"
                      AnchorPane.rightAnchor="100">
                    <ImageView fx:id="enemyPetImage"
                               fitWidth="90" fitHeight="90" preserveRatio="true"/>
                    <Pane styleClass="platform-top"  prefWidth="170" prefHeight="20"/>
                    <Pane styleClass="platform-bottom" prefWidth="170" prefHeight="14"/>
                </VBox>

            </AnchorPane>

            <!-- GROUND STRIP -->
            <Pane styleClass="arena-ground" prefHeight="50" prefWidth="960"/>

        </VBox>

        <!-- WELCOME TEXT -->
        <Label text="WELCOME TO THE ARENA, TRAINER!  SELECT YOUR PET TO START THE BATTLE!"
               styleClass="welcome-text"/>

        <!-- BOTTOM CONTROL BAR — 3 panels -->
        <HBox alignment="CENTER" spacing="16" prefHeight="100">

            <!-- LEFT: pet selector -->
            <VBox styleClass="pet-selector-box" spacing="8"
                  alignment="TOP_LEFT" prefWidth="310" prefHeight="100">
                <Label text="SELECT YOUR PET" styleClass="selector-label"/>
                <HBox spacing="6" alignment="CENTER_LEFT">
                    <Button fx:id="pet1Btn" styleClass="pet-btn pet-btn-selected"
                            prefWidth="48" prefHeight="48"/>
                    <Button fx:id="pet2Btn" styleClass="pet-btn"
                            prefWidth="48" prefHeight="48"/>
                    <Button fx:id="pet3Btn" styleClass="pet-btn"
                            prefWidth="48" prefHeight="48"/>
                    <Button fx:id="pet4Btn" styleClass="pet-btn"
                            prefWidth="48" prefHeight="48"/>
                    <Button fx:id="pet5Btn" styleClass="pet-btn"
                            prefWidth="48" prefHeight="48"/>
                </HBox>
            </VBox>

            <!-- CENTER: BATTLE START -->
            <Button fx:id="battleButton" prefWidth="400" prefHeight="100"
                    styleClass="battle-btn">
                <graphic>
                    <HBox alignment="CENTER" spacing="14">
                        <Label text="⚔" styleClass="battle-icon"/>
                        <Label text="BATTLE&#10;START!" styleClass="battle-label"/>
                    </HBox>
                </graphic>
            </Button>

            <!-- RIGHT: HOW TO PLAY -->
            <Button fx:id="howToPlayBtn" prefWidth="148" prefHeight="100"
                    styleClass="howto-btn">
                <graphic>
                    <VBox alignment="CENTER" spacing="6">
                        <Label text="📋" styleClass="howto-icon"/>
                        <Label text="HOW TO&#10;PLAY" styleClass="howto-label"/>
                    </VBox>
                </graphic>
            </Button>

        </HBox>
    </VBox>
</VBox>
