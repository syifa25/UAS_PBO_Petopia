<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.geometry.*?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.petopia.controller.HomeController"
      styleClass="root-bg"
      prefWidth="1000" prefHeight="700">

    <!-- NAVBAR -->
    <HBox styleClass="navbar" alignment="CENTER" spacing="80" prefHeight="52">
        <Button fx:id="navHome" text="HOME" styleClass="nav-btn nav-active"/>
        <Button fx:id="navMyPets" text="MY PETS" styleClass="nav-btn"/>
        <Button fx:id="navMarketplace" text="LEADERBOARD" styleClass="nav-btn"/>
        <Button fx:id="navLogin" text="LOGIN" styleClass="nav-btn"/>
    </HBox>

    <VBox alignment="CENTER" spacing="14" VBox.vgrow="ALWAYS" styleClass="main-content">

        <!-- ARENA BOX -->
        <VBox styleClass="arena-box" prefWidth="960" prefHeight="420" maxWidth="960">

            <AnchorPane styleClass="arena-sky" VBox.vgrow="ALWAYS">

                <Label text="PETOPIA" styleClass="arena-title"
                       AnchorPane.topAnchor="16"
                       AnchorPane.leftAnchor="0"
                       AnchorPane.rightAnchor="0"/>

                <HBox styleClass="cloud" prefWidth="110" prefHeight="36"
                      AnchorPane.topAnchor="50" AnchorPane.leftAnchor="60"/>

                <HBox styleClass="cloud" prefWidth="110" prefHeight="36"
                      AnchorPane.topAnchor="50" AnchorPane.rightAnchor="60"/>

                <ImageView fx:id="playerPetImage"
                           fitWidth="90" fitHeight="90" preserveRatio="true"
                           AnchorPane.bottomAnchor="10"
                           AnchorPane.leftAnchor="80"/>

                <VBox alignment="BOTTOM_CENTER" spacing="0"
                      AnchorPane.bottomAnchor="0"
                      AnchorPane.rightAnchor="80">
                    <ImageView fx:id="enemyPetImage"
                               fitWidth="90" fitHeight="90" preserveRatio="true"/>
                    <Pane styleClass="platform-top" prefWidth="170" prefHeight="22"/>
                    <Pane styleClass="platform-bottom" prefWidth="170" prefHeight="16"/>
                </VBox>

            </AnchorPane>

            <Pane styleClass="arena-ground" prefHeight="50" prefWidth="960"/>

        </VBox>

        <!-- WELCOME TEXT -->
        <Label text="WELCOME TO THE ARENA, TRAINER! SELECT YOUR PET TO START THE BATTLE!"
               styleClass="welcome-text"/>

        <!-- BOTTOM ROW -->
        <HBox alignment="CENTER" spacing="16" prefHeight="100">

            <VBox styleClass="pet-selector-box" spacing="8"
                  alignment="TOP_LEFT" prefWidth="270" prefHeight="100">
                <Label text="SELECT YOUR PET" styleClass="selector-label"/>
                <HBox spacing="8" alignment="CENTER_LEFT">
                    <Button fx:id="pet1Btn" styleClass="pet-btn pet-btn-selected"
                            prefWidth="52" prefHeight="52"/>
                    <Button fx:id="pet2Btn" styleClass="pet-btn"
                            prefWidth="52" prefHeight="52"/>
                    <Button fx:id="pet3Btn" styleClass="pet-btn"
                            prefWidth="52" prefHeight="52"/>
                    <Button fx:id="pet4Btn" styleClass="pet-btn"
                            prefWidth="52" prefHeight="52"/>
                </HBox>
            </VBox>

            <Button fx:id="battleButton" prefWidth="390" prefHeight="100"
                    styleClass="battle-btn">
                <graphic>
                    <HBox alignment="CENTER" spacing="16">
                        <Label text="⚔" styleClass="battle-icon"/>
                        <Label text="BATTLE&#10;START!" styleClass="battle-label"/>
                    </HBox>
                </graphic>
            </Button>

            <Button fx:id="howToPlayBtn" prefWidth="150" prefHeight="100"
                    styleClass="howto-btn">
                <graphic>
                    <VBox alignment="CENTER" spacing="6">
                        <Label text="📋" styleClass="howto-icon"/>
                        <Label text="HOW TO&#10;PLAY" styleClass="howto-label"/>
                    </VBox>
                </graphic>
            </Button>

        </HBox>
    </VBox>
</VBox>
