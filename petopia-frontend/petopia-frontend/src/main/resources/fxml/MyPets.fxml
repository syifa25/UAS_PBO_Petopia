<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.geometry.*?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.petopia.controller.MyPetsController"
      styleClass="root-bg"
      prefWidth="1000" prefHeight="700">

    <!-- NAVBAR -->
    <HBox styleClass="navbar" alignment="CENTER" spacing="80" prefHeight="48">
        <Button fx:id="navHome"        text="HOME"        styleClass="nav-btn"/>
        <Button fx:id="navMyPets"      text="MY PETS"     styleClass="nav-btn nav-active"/>
        <Button fx:id="navLeaderboard" text="LEADERBOARD" styleClass="nav-btn"/>
        <Button fx:id="navLogin"       text="LOGIN"       styleClass="nav-btn"/>
    </HBox>

    <StackPane VBox.vgrow="ALWAYS" alignment="CENTER" style="-fx-padding: 12;">
        <VBox styleClass="wood-panel" prefWidth="950" maxWidth="950"
              alignment="CENTER" spacing="12">

            <Label text="MY PETS"                              styleClass="mypets-title"/>
            <Label text="HERE ARE YOUR BELOVED COMPANIONS, TRAINER!" styleClass="mypets-subtitle"/>

            <!-- 5 pet cards in one row -->
            <HBox spacing="12" alignment="CENTER">

                <!-- CARD 1 — DOG -->
                <VBox styleClass="pet-card" prefWidth="170" spacing="0">
                    <StackPane styleClass="card-img-area-grass" prefHeight="160">
                        <Pane styleClass="card-sky-blue"   prefWidth="170"/>
                        <Pane styleClass="card-ground-green" prefWidth="170" prefHeight="50"
                              StackPane.alignment="BOTTOM_CENTER"/>
                        <ImageView fx:id="pet1Image" fitWidth="90" fitHeight="90"
                                   preserveRatio="true"
                                   StackPane.alignment="BOTTOM_CENTER" translateY="-44"/>
                        <Label text="READY" styleClass="badge badge-ready"
                               StackPane.alignment="TOP_RIGHT" translateX="-4" translateY="4"/>
                    </StackPane>
                    <VBox styleClass="card-info" spacing="2" prefHeight="68">
                        <Label text="DOG"    styleClass="card-info-text"/>
                        <Label text="LVL: 10" styleClass="card-info-text"/>
                        <Label text="READY"  styleClass="card-info-text card-status-ready"/>
                    </VBox>
                    <HBox styleClass="card-actions" spacing="4" alignment="CENTER">
                        <Button styleClass="act-btn" onAction="#feedPet1"  prefWidth="46" prefHeight="38">
                            <graphic><VBox alignment="CENTER" spacing="1">                                <Label text="FEED" styleClass="act-label"/>
                            </VBox></graphic>
                        </Button>
                        <Button styleClass="act-btn" onAction="#playPet1"  prefWidth="46" prefHeight="38">
                            <graphic><VBox alignment="CENTER" spacing="1">                                <Label text="PLAY" styleClass="act-label"/>
                            </VBox></graphic>
                        </Button>
                        <Button styleClass="act-btn" onAction="#trainPet1" prefWidth="46" prefHeight="38">
                            <graphic><VBox alignment="CENTER" spacing="1">                                <Label text="TRAIN" styleClass="act-label"/>
                            </VBox></graphic>
                        </Button>
                    </HBox>
                </VBox>

                <!-- CARD 2 — RISOL CAT -->
                <VBox styleClass="pet-card" prefWidth="170" spacing="0">
                    <StackPane styleClass="card-img-area-sand" prefHeight="160">
                        <Pane styleClass="card-sky-sand"  prefWidth="170"/>
                        <Pane styleClass="card-ground-sand" prefWidth="170" prefHeight="50"
                              StackPane.alignment="BOTTOM_CENTER"/>
                        <ImageView fx:id="pet2Image" fitWidth="90" fitHeight="90"
                                   preserveRatio="true"
                                   StackPane.alignment="BOTTOM_CENTER" translateY="-44"/>
                        <Label text="READY" styleClass="badge badge-ready"
                               StackPane.alignment="TOP_RIGHT" translateX="-4" translateY="4"/>
                    </StackPane>
                    <VBox styleClass="card-info" spacing="2" prefHeight="68">
                        <Label text="RISOL CAT" styleClass="card-info-text"/>
                        <Label text="LVL: 15"   styleClass="card-info-text"/>
                        <Label text="READY"     styleClass="card-info-text card-status-ready"/>
                    </VBox>
                    <HBox styleClass="card-actions" spacing="4" alignment="CENTER">
                        <Button styleClass="act-btn" onAction="#feedPet2"  prefWidth="46" prefHeight="38">
                            <graphic><VBox alignment="CENTER" spacing="1">                                <Label text="FEED" styleClass="act-label"/>
                            </VBox></graphic>
                        </Button>
                        <Button styleClass="act-btn" onAction="#playPet2"  prefWidth="46" prefHeight="38">
                            <graphic><VBox alignment="CENTER" spacing="1">                                <Label text="PLAY" styleClass="act-label"/>
                            </VBox></graphic>
                        </Button>
                        <Button styleClass="act-btn" onAction="#trainPet2" prefWidth="46" prefHeight="38">
                            <graphic><VBox alignment="CENTER" spacing="1">                                <Label text="TRAIN" styleClass="act-label"/>
                            </VBox></graphic>
                        </Button>
                    </HBox>
                </VBox>

                <!-- CARD 3 — CAT -->
                <VBox styleClass="pet-card" prefWidth="170" spacing="0">
                    <StackPane styleClass="card-img-area-stone" prefHeight="160">
                        <Pane styleClass="card-sky-stone" prefWidth="170"/>
                        <Pane styleClass="card-ground-stone" prefWidth="170" prefHeight="50"
                              StackPane.alignment="BOTTOM_CENTER"/>
                        <ImageView fx:id="pet3Image" fitWidth="90" fitHeight="90"
                                   preserveRatio="true"
                                   StackPane.alignment="BOTTOM_CENTER" translateY="-44"/>
                        <Label text="RESTING" styleClass="badge badge-resting"
                               StackPane.alignment="TOP_RIGHT" translateX="-4" translateY="4"/>
                    </StackPane>
                    <VBox styleClass="card-info" spacing="2" prefHeight="68">
                        <Label text="CAT"      styleClass="card-info-text"/>
                        <Label text="LVL: 12"  styleClass="card-info-text"/>
                        <Label text="RESTING"  styleClass="card-info-text card-status-resting"/>
                    </VBox>
                    <HBox styleClass="card-actions" spacing="4" alignment="CENTER">
                        <Button styleClass="act-btn" onAction="#feedPet3"  prefWidth="46" prefHeight="38">
                            <graphic><VBox alignment="CENTER" spacing="1">                                <Label text="FEED" styleClass="act-label"/>
                            </VBox></graphic>
                        </Button>
                        <Button styleClass="act-btn" onAction="#playPet3"  prefWidth="46" prefHeight="38">
                            <graphic><VBox alignment="CENTER" spacing="1">                                <Label text="PLAY" styleClass="act-label"/>
                            </VBox></graphic>
                        </Button>
                        <Button styleClass="act-btn" onAction="#trainPet3" prefWidth="46" prefHeight="38">
                            <graphic><VBox alignment="CENTER" spacing="1">                                <Label text="TRAIN" styleClass="act-label"/>
                            </VBox></graphic>
                        </Button>
                    </HBox>
                </VBox>

                <!-- CARD 4 — AQUA SLIME -->
                <VBox styleClass="pet-card" prefWidth="170" spacing="0">
                    <StackPane styleClass="card-img-area-grass" prefHeight="160">
                        <Pane styleClass="card-sky-blue"   prefWidth="170"/>
                        <Pane styleClass="card-ground-green" prefWidth="170" prefHeight="50"
                              StackPane.alignment="BOTTOM_CENTER"/>
                        <ImageView fx:id="pet4Image" fitWidth="90" fitHeight="90"
                                   preserveRatio="true"
                                   StackPane.alignment="BOTTOM_CENTER" translateY="-44"/>
                        <Label text="IN TRAINING" styleClass="badge badge-training"
                               StackPane.alignment="TOP_RIGHT" translateX="-4" translateY="4"/>
                    </StackPane>
                    <VBox styleClass="card-info" spacing="2" prefHeight="68">
                        <Label text="AQUA SLIME"  styleClass="card-info-text"/>
                        <Label text="LVL: 5"      styleClass="card-info-text"/>
                        <Label text="IN TRAINING" styleClass="card-info-text card-status-training"/>
                    </VBox>
                    <HBox styleClass="card-actions" spacing="4" alignment="CENTER">
                        <Button styleClass="act-btn" onAction="#feedPet4"  prefWidth="46" prefHeight="38">
                            <graphic><VBox alignment="CENTER" spacing="1">                                <Label text="FEED" styleClass="act-label"/>
                            </VBox></graphic>
                        </Button>
                        <Button styleClass="act-btn" onAction="#playPet4"  prefWidth="46" prefHeight="38">
                            <graphic><VBox alignment="CENTER" spacing="1">                                <Label text="PLAY" styleClass="act-label"/>
                            </VBox></graphic>
                        </Button>
                        <Button styleClass="act-btn" onAction="#trainPet4" prefWidth="46" prefHeight="38">
                            <graphic><VBox alignment="CENTER" spacing="1">                                <Label text="TRAIN" styleClass="act-label"/>
                            </VBox></graphic>
                        </Button>
                    </HBox>
                </VBox>

                <!-- CARD 5 — SWIFT BIRD -->
                <VBox styleClass="pet-card" prefWidth="170" spacing="0">
                    <StackPane styleClass="card-img-area-sand" prefHeight="160">
                        <Pane styleClass="card-sky-sand"  prefWidth="170"/>
                        <Pane styleClass="card-ground-sand" prefWidth="170" prefHeight="50"
                              StackPane.alignment="BOTTOM_CENTER"/>
                        <ImageView fx:id="pet5Image" fitWidth="90" fitHeight="90"
                                   preserveRatio="true"
                                   StackPane.alignment="BOTTOM_CENTER" translateY="-44"/>
                        <Label text="READY" styleClass="badge badge-ready"
                               StackPane.alignment="TOP_RIGHT" translateX="-4" translateY="4"/>
                    </StackPane>
                    <VBox styleClass="card-info" spacing="2" prefHeight="68">
                        <Label text="SWIFT BIRD" styleClass="card-info-text"/>
                        <Label text="LVL: 8"     styleClass="card-info-text"/>
                        <Label text="READY"      styleClass="card-info-text card-status-ready"/>
                    </VBox>
                    <HBox styleClass="card-actions" spacing="4" alignment="CENTER">
                        <Button styleClass="act-btn" onAction="#feedPet5"  prefWidth="46" prefHeight="38">
                            <graphic><VBox alignment="CENTER" spacing="1">                                <Label text="FEED" styleClass="act-label"/>
                            </VBox></graphic>
                        </Button>
                        <Button styleClass="act-btn" onAction="#playPet5"  prefWidth="46" prefHeight="38">
                            <graphic><VBox alignment="CENTER" spacing="1">                                <Label text="PLAY" styleClass="act-label"/>
                            </VBox></graphic>
                        </Button>
                        <Button styleClass="act-btn" onAction="#trainPet5" prefWidth="46" prefHeight="38">
                            <graphic><VBox alignment="CENTER" spacing="1">                                <Label text="TRAIN" styleClass="act-label"/>
                            </VBox></graphic>
                        </Button>
                    </HBox>
                </VBox>

            </HBox>

            <!-- GO TO ARENA -->
            <Button fx:id="goToArenaBtn" styleClass="go-arena-btn"
                    prefWidth="260" prefHeight="60" onAction="#goToArena">
                <graphic>
                    <HBox alignment="CENTER" spacing="12">
                        <Label text="GO TO ARENA" styleClass="go-arena-label"/>
                        <Label text="⚔" styleClass="go-arena-icon"/>
                    </HBox>
                </graphic>
            </Button>

            <VBox.margin><Insets bottom="12"/></VBox.margin>

        </VBox>
    </StackPane>

</VBox>
