<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.geometry.*?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.petopia.controller.MyPetsController"
      styleClass="mypets-root"
      prefWidth="1000" prefHeight="700">

    <!-- NAVBAR -->
    <HBox styleClass="navbar" alignment="CENTER" spacing="80" prefHeight="52">
        <Button fx:id="navHome" text="HOME" styleClass="nav-btn"/>
        <Button fx:id="navMyPets" text="MY PETS" styleClass="nav-btn nav-active"/>
        <Button fx:id="navLeaderboard" text="LEADERBOARD" styleClass="nav-btn"/>
        <Button fx:id="navLogin" text="LOGIN" styleClass="nav-btn"/>
    </HBox>

    <!-- OUTER FRAME -->
    <StackPane VBox.vgrow="ALWAYS" alignment="CENTER">

        <!-- WOOD PANEL -->
        <VBox styleClass="wood-panel" prefWidth="900" maxWidth="900"
              alignment="CENTER" spacing="12">

            <!-- CORNER DECORATIONS (simulasi dengan label) -->

            <!-- Title -->
            <Label text="MY PETS" styleClass="mypets-title"/>
            <Label text="HERE ARE YOUR BELOVED COMPANIONS, TRAINER!"
                   styleClass="mypets-subtitle"/>

            <!-- Pet Cards -->
            <HBox spacing="16" alignment="CENTER">

                <!-- CARD 1 -->
                <VBox styleClass="pet-card" prefWidth="256" spacing="0">
                    <!-- Image Area -->
                    <StackPane styleClass="card-img-area-grass" prefHeight="190">
                        <Pane styleClass="card-sky-blue" prefWidth="256"/>
                        <Pane styleClass="card-ground-green"
                              prefWidth="256" prefHeight="70"
                              StackPane.alignment="BOTTOM_CENTER"/>
                        <ImageView fx:id="pet1Image"
                                   fitWidth="120" fitHeight="120"
                                   preserveRatio="true"
                                   StackPane.alignment="BOTTOM_CENTER"
                                   translateY="-62"/>
                        <Label text="READY" styleClass="badge badge-ready"
                               StackPane.alignment="TOP_RIGHT"
                               translateX="-6" translateY="6"/>
                    </StackPane>
                    <!-- Info -->
                    <VBox styleClass="card-info" spacing="3" prefHeight="78">
                        <Label text="SPECIES: RISSOLE CAT |" styleClass="card-info-text"/>
                        <Label text="LVL: 15" styleClass="card-info-text"/>
                        <HBox spacing="4">
                            <Label text="STATUS:" styleClass="card-info-text"/>
                            <Label text="READY" styleClass="card-info-text card-status-ready"/>
                        </HBox>
                    </VBox>
                    <!-- Actions -->
                    <HBox styleClass="card-actions" spacing="6" alignment="CENTER">
                        <Button styleClass="act-btn" onAction="#feedPet1">
                            <graphic>
                                <VBox alignment="CENTER" spacing="1">
                                    <Label text="🍖" styleClass="act-icon"/>
                                    <Label text="FEED" styleClass="act-label"/>
                                </VBox>
                            </graphic>
                        </Button>
                        <Button styleClass="act-btn" onAction="#playPet1">
                            <graphic>
                                <VBox alignment="CENTER" spacing="1">
                                    <Label text="▶" styleClass="act-icon"/>
                                    <Label text="PLAY" styleClass="act-label"/>
                                </VBox>
                            </graphic>
                        </Button>
                        <Button styleClass="act-btn" onAction="#trainPet1">
                            <graphic>
                                <VBox alignment="CENTER" spacing="1">
                                    <Label text="💪" styleClass="act-icon"/>
                                    <Label text="TRAIN" styleClass="act-label"/>
                                </VBox>
                            </graphic>
                        </Button>
                    </HBox>
                </VBox>

                <!-- CARD 2 -->
                <VBox styleClass="pet-card" prefWidth="256" spacing="0">
                    <StackPane styleClass="card-img-area-sand" prefHeight="190">
                        <Pane styleClass="card-sky-sand" prefWidth="256"/>
                        <Pane styleClass="card-ground-sand"
                              prefWidth="256" prefHeight="70"
                              StackPane.alignment="BOTTOM_CENTER"/>
                        <ImageView fx:id="pet2Image"
                                   fitWidth="120" fitHeight="120"
                                   preserveRatio="true"
                                   StackPane.alignment="BOTTOM_CENTER"
                                   translateY="-62"/>
                        <Label text="RESTING" styleClass="badge badge-resting"
                               StackPane.alignment="TOP_RIGHT"
                               translateX="-6" translateY="6"/>
                    </StackPane>
                    <VBox styleClass="card-info" spacing="3" prefHeight="78">
                        <Label text="SPECIES: GRIZZLY BEAR" styleClass="card-info-text"/>
                        <Label text="LEVEL: 12" styleClass="card-info-text"/>
                        <HBox spacing="4">
                            <Label text="STATUS:" styleClass="card-info-text"/>
                            <Label text="RESTING" styleClass="card-info-text card-status-resting"/>
                        </HBox>
                    </VBox>
                    <HBox styleClass="card-actions" spacing="6" alignment="CENTER">
                        <Button styleClass="act-btn" onAction="#feedPet2">
                            <graphic>
                                <VBox alignment="CENTER" spacing="1">
                                    <Label text="🍖" styleClass="act-icon"/>
                                    <Label text="FEED" styleClass="act-label"/>
                                </VBox>
                            </graphic>
                        </Button>
                        <Button styleClass="act-btn" onAction="#playPet2">
                            <graphic>
                                <VBox alignment="CENTER" spacing="1">
                                    <Label text="▶" styleClass="act-icon"/>
                                    <Label text="PLAY" styleClass="act-label"/>
                                </VBox>
                            </graphic>
                        </Button>
                        <Button styleClass="act-btn" onAction="#trainPet2">
                            <graphic>
                                <VBox alignment="CENTER" spacing="1">
                                    <Label text="💪" styleClass="act-icon"/>
                                    <Label text="TRAIN" styleClass="act-label"/>
                                </VBox>
                            </graphic>
                        </Button>
                    </HBox>
                </VBox>

                <!-- CARD 3 -->
                <VBox styleClass="pet-card" prefWidth="256" spacing="0">
                    <StackPane styleClass="card-img-area-stone" prefHeight="190">
                        <Pane styleClass="card-sky-stone" prefWidth="256"/>
                        <Pane styleClass="card-ground-stone"
                              prefWidth="256" prefHeight="70"
                              StackPane.alignment="BOTTOM_CENTER"/>
                        <ImageView fx:id="pet3Image"
                                   fitWidth="120" fitHeight="120"
                                   preserveRatio="true"
                                   StackPane.alignment="BOTTOM_CENTER"
                                   translateY="-62"/>
                        <Label text="IN TRAINING" styleClass="badge badge-training"
                               StackPane.alignment="TOP_RIGHT"
                               translateX="-6" translateY="6"/>
                    </StackPane>
                    <VBox styleClass="card-info" spacing="3" prefHeight="78">
                        <Label text="SPECIES: AQUA SLIME" styleClass="card-info-text"/>
                        <Label text="LEVEL: 8" styleClass="card-info-text"/>
                        <HBox spacing="4">
                            <Label text="STATUS:" styleClass="card-info-text"/>
                            <Label text="IN TRAINING" styleClass="card-info-text card-status-training"/>
                        </HBox>
                    </VBox>
                    <HBox styleClass="card-actions" spacing="6" alignment="CENTER">
                        <Button styleClass="act-btn" onAction="#feedPet3">
                            <graphic>
                                <VBox alignment="CENTER" spacing="1">
                                    <Label text="🍖" styleClass="act-icon"/>
                                    <Label text="FEED" styleClass="act-label"/>
                                </VBox>
                            </graphic>
                        </Button>
                        <Button styleClass="act-btn" onAction="#playPet3">
                            <graphic>
                                <VBox alignment="CENTER" spacing="1">
                                    <Label text="▶" styleClass="act-icon"/>
                                    <Label text="PLAY" styleClass="act-label"/>
                                </VBox>
                            </graphic>
                        </Button>
                        <Button styleClass="act-btn" onAction="#trainPet3">
                            <graphic>
                                <VBox alignment="CENTER" spacing="1">
                                    <Label text="💪" styleClass="act-icon"/>
                                    <Label text="TRAIN" styleClass="act-label"/>
                                </VBox>
                            </graphic>
                        </Button>
                    </HBox>
                </VBox>

            </HBox>

            <!-- GO TO ARENA -->
            <Button fx:id="goToArenaBtn" styleClass="go-arena-btn"
                    prefWidth="260" prefHeight="70" onAction="#goToArena">
                <graphic>
                    <HBox alignment="CENTER" spacing="12">
                        <Label text="GO TO&#10;ARENA" styleClass="go-arena-label"/>
                        <Label text="⚔" styleClass="go-arena-icon"/>
                    </HBox>
                </graphic>
            </Button>

            <VBox.margin>
                <Insets bottom="20"/>
            </VBox.margin>

        </VBox>
    </StackPane>

</VBox>
