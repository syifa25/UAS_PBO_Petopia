<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.*?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.petopia.controller.LeaderboardController"
      styleClass="root-bg"
      prefWidth="1000" prefHeight="700">

    <!-- NAVBAR -->
    <HBox styleClass="navbar" alignment="CENTER" spacing="80" prefHeight="48">
        <Button fx:id="navHome"        text="HOME"        styleClass="nav-btn"/>
        <Button fx:id="navMyPets"      text="MY PETS"     styleClass="nav-btn"/>
        <Button fx:id="navLeaderboard" text="LEADERBOARD" styleClass="nav-btn nav-active"/>
        <Button fx:id="navLogin"       text="LOGIN"       styleClass="nav-btn"/>
    </HBox>

    <VBox alignment="CENTER" spacing="18" VBox.vgrow="ALWAYS" styleClass="main-content">

        <!-- TITLE with gold underline -->
        <VBox alignment="CENTER" spacing="6">
            <Label text="LEADERBOARD" styleClass="mypets-title"/>
            <!-- gold block underline: 4 squares (simulated via Pane) -->
            <HBox alignment="CENTER" spacing="4">
                <Pane prefWidth="16" prefHeight="5" style="-fx-background-color:#F0C040;"/>
                <Pane prefWidth="16" prefHeight="5" style="-fx-background-color:#F0C040;"/>
                <Pane prefWidth="16" prefHeight="5" style="-fx-background-color:#F0C040;"/>
                <Pane prefWidth="16" prefHeight="5" style="-fx-background-color:#F0C040;"/>
            </HBox>
        </VBox>

        <!-- TABLE -->
        <TableView fx:id="leaderboardTable" prefWidth="880" prefHeight="440">
            <columns>
                <TableColumn fx:id="rankColumn"      text="RANK"       prefWidth="70"/>
                <TableColumn fx:id="usernameColumn"  text="USERNAME"   prefWidth="260"/>
                <TableColumn fx:id="winColumn"       text="WIN"        prefWidth="100"/>
                <TableColumn fx:id="loseColumn"      text="LOSE"       prefWidth="100"/>
                <TableColumn fx:id="scoreColumn"     text="SCORE"      prefWidth="140"/>
                <TableColumn fx:id="lastEnemyColumn" text="LAST ENEMY" prefWidth="200"/>
            </columns>
        </TableView>

        <!-- BACK BUTTON -->
        <Button fx:id="backHomeBtn" styleClass="back-home-btn"
                prefWidth="280" prefHeight="48" onAction="#goToHome">
            <graphic>
                <HBox alignment="CENTER" spacing="8">
                    <Label text="←" styleClass="back-icon"/>
                    <Label text="BACK TO HOME" styleClass="back-label"/>
                </HBox>
            </graphic>
        </Button>

    </VBox>
</VBox>
