<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>

<StackPane xmlns="http://javafx.com/javafx"
           xmlns:fx="http://javafx.com/fxml"
           fx:controller="com.petopia.controller.RegisterController"
           styleClass="login-root"
           prefWidth="1000" prefHeight="700">

    <!-- Centered dialog panel -->
    <VBox styleClass="login-container" alignment="TOP_CENTER" spacing="0"
          prefWidth="440" maxWidth="440">

        <!-- HEADER -->
        <VBox alignment="CENTER" spacing="6" style="-fx-padding: 18 0 12 0;">
            <Label text="PETOPIA ACCOUNT"  styleClass="login-title"/>
            <Label text="CREATE ACCOUNT"   styleClass="login-subtitle"/>
        </VBox>

        <!-- Pixel divider -->
        <Pane styleClass="pixel-divider" prefWidth="380"/>

        <!-- FORM -->
        <VBox alignment="CENTER_LEFT" spacing="10" styleClass="login-form"
              style="-fx-padding: 14 0 8 0;">

            <VBox spacing="5" maxWidth="Infinity">
                <Label text="USERNAME"     styleClass="login-label"/>
                <TextField fx:id="usernameField" styleClass="login-input"
                           promptText="CHOOSE A NAME..." maxWidth="Infinity"/>
            </VBox>

            <VBox spacing="5" maxWidth="Infinity">
                <Label text="DISPLAY NAME" styleClass="login-label"/>
                <TextField fx:id="displayNameField" styleClass="login-input"
                           promptText="TRAINER NAME..." maxWidth="Infinity"/>
            </VBox>

            <VBox spacing="5" maxWidth="Infinity">
                <Label text="PASSWORD"     styleClass="login-label"/>
                <PasswordField fx:id="passwordField" styleClass="login-input"
                               promptText="CREATE PASSWORD..." maxWidth="Infinity"/>
            </VBox>

            <VBox spacing="5" maxWidth="Infinity">
                <Label text="CONFIRM PASSWORD" styleClass="login-label"/>
                <PasswordField fx:id="confirmPasswordField" styleClass="login-input"
                               promptText="CONFIRM..." maxWidth="Infinity"/>
            </VBox>

            <!-- Error -->
            <Label fx:id="errorLabel" styleClass="login-error" text="" wrapText="true"/>

            <!-- Register button -->
            <Button fx:id="registerBtn" text="CREATE ACCOUNT  ▶"
                    styleClass="login-button" maxWidth="Infinity"
                    prefHeight="48"/>

        </VBox>

        <!-- Pixel divider -->
        <Pane styleClass="pixel-divider" prefWidth="380"/>

        <!-- LINK -->
        <VBox alignment="CENTER" spacing="10" style="-fx-padding: 12 0 18 0;">
            <Hyperlink text="ALREADY HAVE AN ACCOUNT?  LOGIN"
                       styleClass="register-link" onAction="#goToLogin"/>
        </VBox>

    </VBox>

</StackPane>
